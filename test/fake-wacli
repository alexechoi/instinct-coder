#!/usr/bin/env node
import assert from 'node:assert/strict';
import { existsSync, readFileSync, statSync, writeFileSync } from 'node:fs';
import { join } from 'node:path';

const [json, storeFlag, directory, group, action, ...flags] = process.argv.slice(2);
assert.equal(json, '--json');
assert.equal(storeFlag, '--store');
const file = join(directory, 'round-trip.json');
const uploadRecord = join(directory, 'image-upload.json');
const chat = process.env.FAKE_WACLI_CHAT || '+15551234567';
const jid = `${chat.slice(1)}@s.whatsapp.net`;
let data;
if (group === 'send' && action === 'file') {
  const option = (name) => flags[flags.indexOf(name) + 1];
  assert.equal(option('--to'), chat);
  assert.equal(option('--as'), 'image');
  assert.equal(option('--mime'), 'image/png');
  const path = option('--file');
  const contents = readFileSync(path);
  assert.equal(contents.subarray(0, 8).toString('hex'), '89504e470d0a1a0a');
  assert.equal(statSync(path).mode & 0o777, 0o600);
  writeFileSync(uploadRecord, JSON.stringify({ path, bytes: contents.length, caption: option('--caption') }));
  data = { sent: true, id: 'fake-image', to: jid };
} else if (group === 'send' && action === 'text') {
  assert.equal(flags[0], '--to');
  assert.equal(flags[1], chat);
  assert.ok(flags.includes('--no-preview'));
  const prompt = flags[flags.indexOf('--message') + 1];
  const marker = prompt.match(/^OPENCODE [\da-f-]+$/m)[0];
  const { messages, tools } = JSON.parse(prompt.split('\n').at(-1));
  const latest = messages.at(-1);
  const transcript = JSON.stringify(messages);
  const startup = join(directory, 'startup-lock');
  if (transcript.includes('LOCK_BRIDGE_FIXTURE') && !existsSync(startup)) {
    writeFileSync(startup, 'locked');
    console.error(JSON.stringify({ success: false, error: 'store is locked (another wacli is running?): fixture' }));
    process.exit(1);
  }
  let reply = { text: 'Hello through the bridge.' };
  if (latest.content?.startsWith('SESSION_BRIDGE_FIXTURE ')) {
    reply = { text: `Completed the ${latest.content.split(' ').at(-1)} task.` };
  } else if (transcript.includes('IMAGE_BRIDGE_FIXTURE')) {
    const { path, bytes, caption } = JSON.parse(readFileSync(uploadRecord, 'utf8'));
    assert.ok(bytes > 1024 * 1024);
    assert.ok(!existsSync(path));
    assert.ok(caption.includes(`${marker.slice('OPENCODE '.length)} — image 1 of 1`));
    assert.ok(latest.content.includes('[WhatsApp image 1]'));
    assert.ok(!prompt.includes('data:image'));
    reply = { text: 'Received the image attachment.' };
  } else if (latest.role === 'user' && transcript.includes('READ_BRIDGE_FIXTURE') && tools.some((tool) => tool.name === 'read')) {
    const path = transcript.match(/\/[^\s"\\]+\/bridge-fixture\.txt/)?.[0];
    assert.ok(path);
    reply = { tool_calls: [{ name: 'read', arguments: { filePath: path } }] };
  } else if (latest.role === 'tool' && transcript.includes('READ_BRIDGE_FIXTURE')) {
    assert.ok(latest.content.includes('bridge-fixture-verified'));
    assert.ok(latest.tool_call_id);
    reply = { text: 'I read the file: bridge-fixture-verified' };
  } else if (transcript.includes('INSTRUCTION_BUDGET_FIXTURE')) {
    assert.ok(latest.content.includes('/project with spaces/CLAUDE.md'));
    assert.ok(latest.content.includes('using the local Read tool in small sections'));
    assert.ok(latest.content.includes('Keep this original user message.'));
    assert.ok(!latest.content.includes('oversized instruction text'));
    if (transcript.includes('READ_INSTRUCTION_BUDGET_FIXTURE')) {
      reply = { tool_calls: [{ name: 'Read', arguments: { file_path: '/project with spaces/CLAUDE.md', limit: 200 } }] };
    }
  } else if (latest.role === 'user' && transcript.includes('CUSTOM_BRIDGE_FIXTURE')) {
    reply = { tool_calls: [{ name: 'apply_patch', arguments: { input: 'Example patch text' } }] };
  } else if (latest.role === 'tool' && transcript.includes('CUSTOM_BRIDGE_FIXTURE')) {
    assert.equal(latest.content, 'Patch applied.');
    reply = { text: 'Patch was applied.' };
  } else if (transcript.includes('INVALID_TOOL')) {
    reply = { tool_calls: [{ name: 'undeclared', arguments: {} }] };
  }
  writeFileSync(file, JSON.stringify({ marker, reply, silent: transcript.includes('TIMEOUT_FIXTURE') }));
  data = { sent: true, id: 'fake-outgoing', to: jid };
} else {
  assert.equal(group, 'messages');
  assert.equal(action, 'list');
  assert.equal(flags[flags.indexOf('--chat') + 1], jid);
  assert.ok(flags.includes('--from-them'));
  const { marker, reply, silent } = JSON.parse(readFileSync(file, 'utf8'));
  data = { messages: [
    { FromMe: false, Text: 'OPENCODE 00000000-0000-0000-0000-000000000000\n{"text":"Stale"}' },
    { FromMe: true, Text: `${marker}\n{"text":"Outgoing"}` },
    ...(silent ? [] : [{ FromMe: false, Text: `${marker}\n\x60\x60\x60json\n${JSON.stringify(reply)}\n\x60\x60\x60` }]),
  ] };
}
console.log(JSON.stringify({ success: true, data, error: null }));
