#!/usr/bin/env node
import assert from 'node:assert/strict';
import { appendFileSync, existsSync } from 'node:fs';
import { setTimeout as delay } from 'node:timers/promises';

const args = process.argv.slice(2);
if (args[0] === '--print-logs') {
  assert.deepEqual(args, ['--print-logs', 'db', 'path']);
  if (process.env.FAKE_OPENCODE_PROBE_LOG) appendFileSync(process.env.FAKE_OPENCODE_PROBE_LOG, 'probe\n');
  if (process.env.FAKE_OPENCODE_DB_ERROR) {
    console.error(process.env.FAKE_OPENCODE_DB_ERROR);
    process.exit(1);
  }
  process.exit(0);
}

const task = args[1];
assert.match(task, /^(Hello|SESSION_BRIDGE_FIXTURE (first|second))$/);
assert.deepEqual(args, ['run', task, '--model', 'instinct/instinct-whatsapp']);
assert.equal(process.env.OPENCODE_DB, process.env.FAKE_OPENCODE_EXPECT_DB);
assert.equal(process.env.PWD, process.cwd());
const config = JSON.parse(process.env.OPENCODE_CONFIG_CONTENT);
const { baseURL } = config.provider.instinct.options;
if (process.env.FAKE_OPENCODE_SESSIONS_LOG) {
  appendFileSync(process.env.FAKE_OPENCODE_SESSIONS_LOG, `${JSON.stringify({ task, baseURL })}\n`);
}
if (task.endsWith(' second')) {
  while (!existsSync(process.env.FAKE_OPENCODE_SECOND_READY)) await delay(30);
}
const result = await fetch(`${baseURL}/chat/completions`, {
  method: 'POST',
  headers: { Authorization: `Bearer ${process.env.INSTINCT_BRIDGE_KEY}`, 'Content-Type': 'application/json' },
  body: JSON.stringify({ model: 'instinct-whatsapp', messages: [{ role: 'user', content: task }] }),
});
assert.equal(result.status, 200);
console.log((await result.json()).choices[0].message.content);
